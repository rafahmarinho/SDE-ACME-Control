<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required to debug with Flutter tooling. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may talk to a local API over plain http (e.g. http://10.0.2.2:3001/api). -->
    <application android:usesCleartextTraffic="true" tools:ignore="UnusedAttribute" />
</manifest>
