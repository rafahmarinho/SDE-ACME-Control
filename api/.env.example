# ACME Control API - environment variables
# Copy to .env for local development. On Vercel, add these in Project Settings > Environment Variables.

# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key - server side only, never ship it in the Flutter app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used only by `pnpm db:setup` / `pnpm db:seed`
# (Project Settings > Database > Connection string, URI, session mode)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local dev server port (pnpm dev)
PORT=3001

# Comma separated list of allowed browser origins, or * for any
CORS_ORIGINS=*
